{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "AppsScript/**"
    ],
    "rewrites": [
      {
        "source": "/Guiones",
        "destination": "/Guiones/index.html"
      },
      {
        "source": "/Guiones/**",
        "destination": "/Guiones/index.html"
      }
    ]
  }
}